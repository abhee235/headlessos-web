{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "headlessos-web",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Serve /download from download/index.html directly, matching Astro's trailingSlash: "never"
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
