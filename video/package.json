{
  "name": "headlessos-launch-video",
  "version": "1.0.0",
  "description": "The HeadlessOS launch video, made with Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/effects": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --port 3600",
    "render": "remotion render Launch out/headlessos-launch.mp4 --codec=h264 --crf=17 --jpeg-quality=95 --x264-preset=slow",
    "render:readme": "remotion ffmpeg -y -i out/headlessos-launch.mp4 -vf scale=1280:-2 -c:v libx264 -preset slow -crf 27 -pix_fmt yuv420p -movflags +faststart -an out/headlessos-launch-readme.mp4",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
