---
// Download: links start at the GitHub releases page and are upgraded to direct
// asset links from the latest release when the GitHub API answers.
import BaseLayout from "@/layouts/BaseLayout.astro";

const releases = "https://github.com/abhee235/headlessos/releases/latest";

const platforms = [
  {
    id: "windows",
    name: "Windows",
    req: "Windows 10 or 11 · 64-bit",
    icon: '<path fill="currentColor" stroke="none" d="M3 5.5l7.5-1v7H3v-6zm0 13l7.5 1v-7H3v6zm8.5 1.2L21 21v-8.5h-9.5v7.2zm0-15.4v7.2H21V3l-9.5 1.3z"/>',
    primary: { key: "win-setup", label: "Installer", ext: ".exe" },
    secondary: { key: "win-portable", label: "Portable", ext: ".exe" },
    note: "Builds aren't code-signed yet, so SmartScreen may warn on first run. Choose More info, then Run anyway.",
  },
  {
    id: "mac",
    name: "macOS",
    req: "macOS 11 or later · Apple silicon & Intel",
    icon: '<path fill="currentColor" stroke="none" d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.1-1.2 2.9-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.4-.9-2.4-3.8zM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4z"/>',
    primary: { key: "mac-dmg", label: "Disk image", ext: ".dmg" },
    secondary: { key: "mac-zip", label: "Zip", ext: ".zip" },
    note: "The app isn't notarized yet. If macOS blocks it, open System Settings → Privacy & Security and choose Open Anyway.",
  },
  {
    id: "linux",
    name: "Linux",
    req: "64-bit · most desktop distributions",
    icon: '<path d="M4 17l6-6-6-6M12 19h8"/>',
    primary: { key: "linux-appimage", label: "AppImage", ext: ".AppImage" },
    secondary: { key: "linux-deb", label: "Debian / Ubuntu", ext: ".deb" },
    note: "Make the AppImage executable (chmod +x) and run it, or install the .deb with your package manager.",
  },
];
---

<BaseLayout
  title="Download HeadlessOS — Windows, macOS and Linux"
  description="Download HeadlessOS, a free and open-source desktop for your VPS and servers. For Windows, macOS and Linux, or run it from source."
>
  <section class="relative isolate overflow-hidden pb-10 pt-20 sm:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="bg-grid absolute inset-0"></div>
      <div class="aurora left-[12%] top-[-20%] h-[380px] w-[560px] bg-[#00d4ff]/25"></div>
      <div class="aurora right-[10%] top-[-10%] h-[360px] w-[520px] bg-[#7c3aed]/30 [animation-delay:-9s]"></div>
    </div>
    <div class="container-x text-center">
      <p class="rv eyebrow">Download</p>
      <h1 class="rv display mx-auto mt-6 max-w-4xl [--d:.05s]">Get HeadlessOS</h1>
      <p class="rv lede mx-auto mt-6 max-w-xl [--d:.1s]">
        Free and open source. Install it on your computer; your VPS and servers don't need anything.
      </p>
      <p class="rv mt-5 font-mono text-sm text-fg-subtle [--d:.14s]" data-release-line>
        Latest release on <a class="underline decoration-white/25 underline-offset-4 hover:text-fg" href={releases}>GitHub</a>
      </p>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-x grid gap-4 lg:grid-cols-3 lg:gap-6">
      {
        platforms.map((p, i) => (
          <article id={p.id} class="rv card platform flex scroll-mt-28 flex-col p-7 sm:p-8" style={`--d:${0.06 * i}s`} data-platform={p.id}>
            <div class="flex items-start justify-between">
              <span class="icon-tile !h-12 !w-12 [--tile:#e5e7eb]">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
              </span>
              <span class="mine-badge chip" hidden data-mine-badge>
                For this computer
              </span>
            </div>
            <h2 class="mt-6 text-2xl font-semibold tracking-tight">{p.name}</h2>
            <p class="mt-1 text-sm text-fg-subtle">{p.req}</p>

            <div class="mt-8 flex flex-col gap-2.5">
              <a href={releases} class="btn btn-primary btn-lg justify-between" data-asset={p.primary.key}>
                <span class="flex items-center gap-2.5">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19.5h14" /></svg>
                  {p.primary.label}
                </span>
                <span class="font-mono text-xs opacity-60" data-asset-meta>{p.primary.ext}</span>
              </a>
              <a href={releases} class="btn btn-secondary btn-lg justify-between" data-asset={p.secondary.key}>
                <span>{p.secondary.label}</span>
                <span class="font-mono text-xs text-fg-subtle" data-asset-meta>{p.secondary.ext}</span>
              </a>
            </div>
            <p class="missing mt-4 hidden text-sm text-fg-muted" data-missing>
              Not in this release yet. <a href="#source" class="text-fg underline decoration-white/30 underline-offset-4">Run it from source</a> in the meantime.
            </p>
            <p class="mt-auto pt-8 text-sm leading-relaxed text-fg-subtle">{p.note}</p>
          </article>
        ))
      }
    </div>
    <p class="container-x mt-8 text-center text-sm text-fg-subtle">
      Older versions and checksums are on the <a class="text-fg-muted underline decoration-white/25 underline-offset-4 hover:text-fg" href="https://github.com/abhee235/headlessos/releases">releases page</a>.
    </p>
  </section>

  <section id="source" class="scroll-mt-24 border-t border-border py-24">
    <div class="container-x grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="rv eyebrow">From source</p>
        <h2 class="rv h2 mt-5 [--d:.05s]">Prefer your browser?</h2>
        <p class="rv lede mt-6 max-w-lg [--d:.1s]">
          Clone the repo and run it locally. The app opens at localhost and never listens on your network.
          Needs Node.js 20 or later.
        </p>
      </div>
      <pre class="rv term !text-[0.9rem] [--d:.1s]"><span class="dim">$</span> <span class="hi">git clone https://github.com/abhee235/headlessos.git</span>
<span class="dim">$</span> <span class="hi">cd headlessos && npm install</span>
<span class="dim">$</span> <span class="hi">npm run dev</span>
<span class="ok">➜</span> open <span class="cy">http://localhost:3000</span></pre>
    </div>
  </section>

  <section class="border-t border-border py-24">
    <div class="container-x grid gap-4 md:grid-cols-3">
      <a href="/docs/getting-started" class="rv card group p-7 transition-colors hover:border-white/20">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-brand-300">Next</p>
        <h3 class="mt-3 text-lg font-semibold">Connect your first server →</h3>
        <p class="mt-2 text-fg-muted">Add a host, sign in, and find your way around the desktop.</p>
      </a>
      <a href="/docs/introduction" class="rv card group p-7 transition-colors hover:border-white/20 [--d:.06s]">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-accent-300">Docs</p>
        <h3 class="mt-3 text-lg font-semibold">How it works →</h3>
        <p class="mt-2 text-fg-muted">The architecture, the parsers and the security model.</p>
      </a>
      <a href="https://github.com/abhee235/headlessos/issues" class="rv card group p-7 transition-colors hover:border-white/20 [--d:.12s]">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">Help</p>
        <h3 class="mt-3 text-lg font-semibold">Report an issue →</h3>
        <p class="mt-2 text-fg-muted">Found a bug or missing a feature? Tell us on GitHub.</p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .platform[data-mine="true"] {
    border-color: rgba(61, 220, 255, 0.35);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 30px 80px -40px rgba(0, 212, 255, 0.45);
  }

  .platform:not([data-mine="true"]) .btn-primary {
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-fg);
    box-shadow: 0 0 0 1px var(--color-border-strong) inset;
  }

  .platform:not([data-mine="true"]) .btn-primary:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .platform[data-unavailable="true"] [data-asset],
  [data-asset][data-absent="true"] {
    display: none;
  }

  .platform[data-unavailable="true"] [data-missing] {
    display: block;
  }

  .mine-badge {
    color: var(--color-brand-200);
    border-color: rgba(61, 220, 255, 0.35);
    background: rgba(61, 220, 255, 0.08);
  }
</style>

<script>
  import { detectOS } from "@/lib/platform";

  // Highlight the visitor's platform
  const os = detectOS();
  if (os) {
    const card = document.querySelector<HTMLElement>(`[data-platform="${os}"]`);
    if (card) {
      card.dataset.mine = "true";
      card.querySelector<HTMLElement>("[data-mine-badge]")?.removeAttribute("hidden");
    }
  }

  type Asset = { name: string; size: number; browser_download_url: string };
  type Release = { tag_name: string; published_at: string; html_url: string; assets: Asset[] };

  const MATCH: Record<string, (n: string) => boolean> = {
    "win-setup": (n) => /setup.*\.exe$/i.test(n),
    "win-portable": (n) => /\.exe$/i.test(n) && !/setup/i.test(n),
    "mac-dmg": (n) => /\.dmg$/i.test(n),
    "mac-zip": (n) => /mac.*\.zip$/i.test(n),
    "linux-appimage": (n) => /\.appimage$/i.test(n),
    "linux-deb": (n) => /\.deb$/i.test(n),
  };

  const mb = (bytes: number) => `${Math.round(bytes / 1_000_000)} MB`;

  fetch("https://api.github.com/repos/abhee235/headlessos/releases/latest", {
    headers: { Accept: "application/vnd.github+json" },
  })
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((rel: Release) => {
      const line = document.querySelector("[data-release-line]");
      if (line) {
        const date = new Date(rel.published_at).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
        line.innerHTML = `Latest: <a class="text-fg-muted underline decoration-white/25 underline-offset-4 hover:text-fg" href="${rel.html_url}">${rel.tag_name}</a> · ${date}`;
      }
      document.querySelectorAll<HTMLAnchorElement>("[data-asset]").forEach((a) => {
        const asset = rel.assets.find((x) => MATCH[a.dataset.asset!]?.(x.name));
        if (!asset) {
          a.dataset.absent = "true";
          return;
        }
        a.href = asset.browser_download_url;
        const meta = a.querySelector("[data-asset-meta]");
        if (meta) meta.textContent = `${meta.textContent} · ${mb(asset.size)}`;
      });
      // A platform with no files in this release points to the source instead
      document.querySelectorAll<HTMLElement>("[data-platform]").forEach((card) => {
        const links = card.querySelectorAll<HTMLAnchorElement>("[data-asset]");
        if ([...links].every((a) => a.dataset.absent === "true")) card.dataset.unavailable = "true";
      });
    })
    .catch(() => {
      /* Rate-limited or offline: the buttons keep pointing at the releases page */
    });
</script>
