---
// Download: links start at the GitHub releases page and are upgraded to direct
// asset links from the latest release when the GitHub API answers.
import BaseLayout from "@/layouts/BaseLayout.astro";
import PlatformCards from "@/components/PlatformCards.astro";

const releases = "https://github.com/abhee235/headlessos/releases/latest";
---

<BaseLayout
  title="Download HeadlessOS — Windows, macOS and Linux"
  description="Download HeadlessOS, a free and open-source desktop for your VPS and servers. For Windows, macOS and Linux, or run it from source."
>
  <section class="relative isolate overflow-hidden pb-10 pt-20 sm:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="bg-grid absolute inset-0"></div>
      <div class="aurora left-[12%] top-[-20%] h-[380px] w-[560px] bg-[#00d4ff]/25"></div>
      <div class="aurora right-[10%] top-[-10%] h-[360px] w-[520px] bg-[#7c3aed]/30 [animation-delay:-9s]"></div>
    </div>
    <div class="container-x text-center">
      <p class="rv eyebrow">Download</p>
      <h1 class="rv display mx-auto mt-6 max-w-4xl [--d:.05s]">Get HeadlessOS</h1>
      <p class="rv lede mx-auto mt-6 max-w-xl [--d:.1s]">
        Free and open source. Install it on your computer; your VPS and servers don't need anything.
      </p>
      <p class="rv mt-5 font-mono text-sm text-fg-subtle [--d:.14s]" data-release-line>
        Latest release on <a class="underline decoration-ink/25 underline-offset-4 hover:text-fg" href={releases}>GitHub</a>
      </p>
    </div>
  </section>

  <section class="pb-24">
    <PlatformCards class="container-x grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-6" />
    <p class="container-x mt-8 text-center text-sm text-fg-subtle">
      Older versions and checksums are on the <a class="text-fg-muted underline decoration-ink/25 underline-offset-4 hover:text-fg" href="https://github.com/abhee235/headlessos/releases">releases page</a>.
    </p>
  </section>

  <section id="source" class="scroll-mt-24 border-t border-border py-24">
    <div class="container-x grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="rv eyebrow">From source</p>
        <h2 class="rv h2 mt-5 [--d:.05s]">Prefer your browser?</h2>
        <p class="rv lede mt-6 max-w-lg [--d:.1s]">
          Clone the repo and run it locally. The app opens at localhost and never listens on your network.
          Needs Node.js 20 or later.
        </p>
      </div>
      <pre class="rv term !text-[0.9rem] [--d:.1s]"><span class="dim">$</span> <span class="hi">git clone https://github.com/abhee235/headlessos.git</span>
<span class="dim">$</span> <span class="hi">cd headlessos && npm install</span>
<span class="dim">$</span> <span class="hi">npm run dev</span>
<span class="ok">➜</span> open <span class="cy">http://localhost:3000</span></pre>
    </div>
  </section>

  <section class="border-t border-border py-24">
    <div class="container-x grid gap-4 md:grid-cols-3">
      <a href="/docs/getting-started" class="rv card group p-7 transition-colors hover:border-ink/20">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-brand-300">Next</p>
        <h3 class="mt-3 text-lg font-semibold">Connect your first server →</h3>
        <p class="mt-2 text-fg-muted">Add a host, sign in, and find your way around the desktop.</p>
      </a>
      <a href="/docs" class="rv card group p-7 transition-colors hover:border-ink/20 [--d:.06s]">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-accent-300">Docs</p>
        <h3 class="mt-3 text-lg font-semibold">How it works →</h3>
        <p class="mt-2 text-fg-muted">The architecture, the parsers and the security model.</p>
      </a>
      <a href="https://github.com/abhee235/headlessos/issues" class="rv card group p-7 transition-colors hover:border-ink/20 [--d:.12s]">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">Help</p>
        <h3 class="mt-3 text-lg font-semibold">Report an issue →</h3>
        <p class="mt-2 text-fg-muted">Found a bug or missing a feature? Tell us on GitHub.</p>
      </a>
    </div>
  </section>
</BaseLayout>
