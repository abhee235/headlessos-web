---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Blog — HeadlessOS"
  description="Release notes and deep-dives from HeadlessOS, the free, open-source desktop for your VPS, cloud servers and home lab."
>
  <section class="relative isolate overflow-hidden pb-14 pt-20 sm:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="bg-grid absolute inset-0"></div>
      <div class="aurora left-[12%] top-[-20%] h-[380px] w-[560px] bg-[#00d4ff]/25"></div>
      <div class="aurora right-[10%] top-[-10%] h-[360px] w-[520px] bg-[#7c3aed]/30 [animation-delay:-9s]"></div>
    </div>
    <div class="container-x text-center">
      <p class="rv eyebrow">Blog</p>
      <h1 class="rv display mx-auto mt-6 max-w-4xl [--d:.05s]">The HeadlessOS blog</h1>
      <p class="rv lede mx-auto mt-6 max-w-xl [--d:.1s]">
        Release notes, how it works under the hood, and what's coming next.
      </p>
    </div>
  </section>

  <section class="pb-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-7">
      {
        posts.length === 0 ? (
          <p class="py-20 text-center text-fg-muted">No posts yet. Check back soon.</p>
        ) : (
          <ul class="flex flex-col gap-4">
            {posts.map((post, i) => (
              <li class="rv" style={`--d:${0.06 * i}s`}>
                <a href={`/blog/${post.id}`} class="card group block p-7 transition-colors hover:border-ink/20 sm:p-8">
                  <p class="font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">
                    <time datetime={post.data.pubDate.toISOString()}>{formatter.format(post.data.pubDate)}</time>
                    <span aria-hidden="true"> · </span>
                    {post.data.author}
                  </p>
                  <h2 class="mt-3 text-2xl font-semibold tracking-tight">{post.data.title}</h2>
                  <p class="mt-2 leading-relaxed text-fg-muted">{post.data.description}</p>
                  <div class="mt-6 flex flex-wrap items-center gap-2">
                    {post.data.tags.map((t) => (
                      <span class="chip !py-0.5 !text-xs">#{t}</span>
                    ))}
                    <span class="ml-auto text-sm font-medium text-fg transition-transform group-hover:translate-x-0.5">
                      Read →
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
