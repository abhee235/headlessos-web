---
// The hero: what HeadlessOS is in one line, then the app itself running in a loop.
import { getImage } from "astro:assets";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import poster from "@/assets/screens/demo-poster.webp";

const posterImg = await getImage({ src: poster, width: 1600, format: "webp", quality: 82 });

// public/ files keep their names, so a content hash in the URL makes caches pick up a new recording
const media = (file: string) =>
  `/media/${file}?v=${createHash("sha1").update(readFileSync(join(process.cwd(), "public", "media", file))).digest("hex").slice(0, 8)}`;
---

<section class="hero relative isolate overflow-hidden pt-20 sm:pt-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="bg-grid absolute inset-0"></div>
    <div class="aurora left-[8%] top-[-12%] h-[420px] w-[620px] bg-[#00d4ff]/30"></div>
    <div class="aurora right-[4%] top-[2%] h-[380px] w-[560px] bg-[#7c3aed]/35 [animation-delay:-9s]"></div>
  </div>

  <div class="container-x text-center">
    <a href="https://github.com/abhee235/headlessos" class="rv hero-pill" target="_blank" rel="noopener">
      <span class="hero-pill-tag">Open source</span>
      <span class="sm:hidden">Free, no account</span>
      <span class="hidden sm:inline">Free, no account, nothing to install on the server</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
    </a>

    <h1 class="rv display mx-auto mt-7 max-w-5xl [--d:.06s]">
      <span class="sr-only">A desktop for your VPS, cloud server, home lab or Raspberry Pi.</span>
      <span aria-hidden="true">
        <span class="block text-balance">A desktop for your</span>
        <!-- The changing word has a line of its own, so nothing else moves when it changes -->
        <span class="rotator" data-rotator>
          {
            ["VPS.", "cloud server.", "home lab.", "Raspberry Pi."].map((w, i) => (
              <span class:list={["word", { "is-on": i === 0 }]}><span class="gradient-text">{w}</span></span>
            ))
          }
        </span>
      </span>
    </h1>

    <p class="rv lede mx-auto mt-7 max-w-2xl [--d:.12s]">
      Open any server you can SSH into and use it like your own computer. Drag files, restart containers,
      watch CPU and read logs in real windows. No commands to memorize, and nothing installed on the server.
    </p>

    <div class="rv mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row [--d:.18s]">
      <a href="/download" class="btn btn-primary btn-lg w-full sm:w-auto" data-download-cta>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path></svg>
        <span data-download-label>Download free</span>
      </a>
      <a href="https://github.com/abhee235/headlessos" target="_blank" rel="noopener" class="btn btn-secondary btn-lg w-full sm:w-auto">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.53L12 17.5l-5.87 3.07 1.12-6.53L2.5 9.41l6.56-.95L12 2.5z"></path></svg>
        Star on GitHub
      </a>
    </div>

    <p class="rv mt-6 font-mono text-[0.8rem] text-fg-subtle [--d:.22s]">
      Windows · macOS · Linux&nbsp;&nbsp;—&nbsp;&nbsp;free, no account, no telemetry
    </p>
  </div>

  <!-- The app, running -->
  <div class="relative mx-auto mt-16 w-full max-w-[1280px] px-3 sm:mt-20 sm:px-6">
    <div aria-hidden="true" class="horizon"></div>
    <figure class="rv frame [--d:.28s]">
      <video
        class="frame-media"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={posterImg.src}
        width="1600"
        height="1000"
        aria-label="HeadlessOS running: adding a VPS and signing in, then the Home hub, Dashboard, File Explorer, Docker and Terminal"
        data-demo-video
      >
        <source src={media("headlessos-demo.webm")} type="video/webm" />
        <source src={media("headlessos-demo.mp4")} type="video/mp4" />
      </video>
      <button type="button" class="video-toggle" aria-label="Pause video" data-video-toggle>
        <svg class="i-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
        <svg class="i-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
      </button>
    </figure>
    <p class="rv mt-5 text-center font-mono text-xs text-fg-subtle">
      Recorded live: adding a VPS, then the Home hub, Dashboard, Files, Docker and Terminal
    </p>
  </div>
</section>

<style>
  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 5px 12px 5px 5px;
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    background: rgb(var(--ink) / 0.04);
    border: 1px solid var(--color-border-strong);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .hero-pill:hover {
    color: var(--color-fg);
    border-color: rgb(var(--ink) / 0.24);
  }

  .hero-pill-tag {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    color: #041218;
    background: linear-gradient(100deg, #7ce7ff, #00d4ff);
  }

  /* The changing word: a line of fixed height; each word is centred on its own and they
     stack in one grid cell, so a long or short word never moves anything else.
     Words roll up through the line, clipped at its edges, like a split-flap board. */
  .rotator {
    display: grid;
    height: 1.12em; /* one line plus room for descenders (y, p) */
    overflow: hidden;
    white-space: nowrap;
  }

  .rotator .word {
    grid-area: 1 / 1;
    justify-self: center;
    padding-bottom: 0.1em;
    opacity: 0;
    filter: blur(6px);
    transform: translateY(70%);
    transition:
      opacity 0.45s ease,
      filter 0.45s ease,
      transform 0.6s cubic-bezier(0.2, 0.75, 0.15, 1);
  }

  .rotator .word.is-on {
    opacity: 1;
    filter: none;
    transform: none;
    transition-delay: 0.12s; /* let the outgoing word clear first */
  }

  .rotator .word.is-out {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(-70%);
  }

  /* A rising glow behind the top of the product frame */
  .horizon {
    position: absolute;
    left: 50%;
    top: -70px;
    width: min(1100px, 92vw);
    height: 220px;
    transform: translateX(-50%);
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 50% 100%, rgba(0, 212, 255, 0.45), transparent 62%),
      radial-gradient(ellipse at 30% 100%, rgba(124, 58, 237, 0.45), transparent 60%),
      radial-gradient(ellipse at 72% 100%, rgba(167, 139, 250, 0.35), transparent 60%);
    filter: blur(40px);
    opacity: calc(0.4 + 0.6 * var(--glow-strength));
    pointer-events: none;
    z-index: -1;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    background: linear-gradient(transparent, var(--color-bg));
    pointer-events: none;
    z-index: -1;
  }

  .video-toggle {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    color: #fff;
    background: rgba(7, 8, 12, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .frame:hover .video-toggle,
  .video-toggle:focus-visible,
  .video-toggle[data-paused="true"] {
    opacity: 1;
  }

  .video-toggle .i-play,
  .video-toggle[data-paused="true"] .i-pause {
    display: none;
  }

  .video-toggle[data-paused="true"] .i-play {
    display: block;
  }
</style>

<script>
  import { labelDownloadButtons } from "@/lib/platform";

  labelDownloadButtons();

  // Cycle the headline's last line. The word leaving rolls up and out; the next rolls in from below.
  const rotator = document.querySelector<HTMLElement>("[data-rotator]");
  if (rotator && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const words = [...rotator.querySelectorAll<HTMLElement>(".word")];
    let i = 0;
    window.setInterval(() => {
      if (document.hidden) return;
      const prev = words[i];
      i = (i + 1) % words.length;
      prev.classList.replace("is-on", "is-out");
      words[i].classList.add("is-on");
      // back below the line, unseen, ready for its next turn
      window.setTimeout(() => prev.classList.remove("is-out"), 650);
    }, 2600);
  }

  const video = document.querySelector<HTMLVideoElement>("[data-demo-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-video-toggle]");
  if (video && toggle) {
    const sync = () => {
      toggle.dataset.paused = String(video.paused);
      toggle.setAttribute("aria-label", video.paused ? "Play video" : "Pause video");
    };
    // Respect reduced motion: show the poster and let the visitor start it
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.pause();
    }
    toggle.addEventListener("click", () => (video.paused ? video.play() : video.pause()));
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    sync();
  }
</script>
