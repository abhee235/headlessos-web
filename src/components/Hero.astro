---
// The hero: what HeadlessOS is in one line, then the app itself running in a loop, on the Alpine wallpaper.
import { Image, getImage } from "astro:assets";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import poster from "@/assets/screens/demo-poster.webp";
import alpine from "@/assets/wallpapers/alpine.jpg";

const posterImg = await getImage({ src: poster, width: 1600, format: "webp", quality: 82 });

// public/ files keep their names, so a content hash in the URL makes caches pick up a new recording
const media = (file: string) =>
  `/media/${file}?v=${createHash("sha1").update(readFileSync(join(process.cwd(), "public", "media", file))).digest("hex").slice(0, 8)}`;

const words = ["VPS.", "cloud server.", "home lab.", "Raspberry Pi."];
const facts = ["Nothing installed on the server", "No account, no telemetry", "Free and open source, MIT", "Works with or without AI"];
---

<section id="top">
  <div class="flex flex-col items-center px-5 pt-[clamp(36px,4.6vw,68px)] text-center">
    <h1 class="max-w-[12em] text-[clamp(44px,5.8vw,84px)] leading-none font-[680] tracking-[-0.045em]">
      <span class="sr-only">A desktop for your VPS, cloud server, home lab or Raspberry Pi.</span>
      <span aria-hidden="true">
        <span class="block text-balance">A desktop for your</span>
        <!-- The changing word has a line of its own, so nothing else moves when it changes -->
        <span class="rotator text-accent-text" data-rotator>
          {words.map((w, i) => <span class:list={["word", { "is-on": i === 0 }]}>{w}</span>)}
        </span>
      </span>
    </h1>
    <p class="lede mt-7 max-w-[34rem]">
      Open any Linux server you can SSH into and use it like your own computer. Drag files, restart containers, watch CPU and
      read logs in real windows. No commands to memorize, and nothing installed on the server.
    </p>
    <div class="mt-8 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
      <a href="/download" class="btn btn-primary btn-lg w-full sm:w-auto" data-download-cta>
        <span data-download-label>Download free</span>
      </a>
      <a href="https://github.com/abhee235/headlessos" target="_blank" rel="noopener" class="btn btn-secondary btn-lg w-full sm:w-auto">
        Star on GitHub
      </a>
    </div>
    <p class="mt-[18px] text-[14.5px] text-fg-subtle">Windows, macOS and Linux. Free, no account, no telemetry.</p>
  </div>

  <!-- The app, running, on one of its own wallpapers -->
  <div class="band mt-[clamp(36px,3.6vw,52px)]">
    <Image src={alpine} alt="" widths={[960, 1600, 2400]} sizes="100vw" loading="eager" class="band-media alpine" />
    <div class="p-[clamp(14px,3.4vw,48px)]">
      <figure class="video-frame relative mx-auto max-w-[1120px]">
        <video
          class="block h-auto w-full"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={posterImg.src}
          width="1600"
          height="1000"
          aria-label="HeadlessOS running: adding a VPS and signing in, then the Home hub, Dashboard, File Explorer, Docker and Terminal"
          data-demo-video
        >
          <source src={media("headlessos-demo.webm")} type="video/webm" />
          <source src={media("headlessos-demo.mp4")} type="video/mp4" />
        </video>
        <button type="button" class="video-toggle" aria-label="Pause video" data-video-toggle>
          <svg class="i-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
          <svg class="i-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
        </button>
      </figure>
    </div>
  </div>

  <div class="container-x">
    <ul class="flex flex-wrap justify-between gap-x-7 gap-y-1 border-b-[0.5px] border-ink/15 py-[26px]">
      {
        facts.map((f) => (
          <li class="flex min-h-9 items-center gap-[9px] text-[15px] font-[560] text-fg-muted">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-accent" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {f}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .alpine {
    object-position: center 42%;
  }

  /* The changing word: a line of fixed height; each word is centred on its own and they stack in one grid
     cell, so a long or short word never moves anything else. Words roll up through the line. */
  .rotator {
    display: grid;
    height: 1.12em;
    overflow: hidden;
    white-space: nowrap;
  }

  .rotator .word {
    grid-area: 1 / 1;
    justify-self: center;
    padding-bottom: 0.1em;
    opacity: 0;
    filter: blur(6px);
    transform: translateY(70%);
    transition:
      opacity 0.45s ease,
      filter 0.45s ease,
      transform 0.6s cubic-bezier(0.2, 0.75, 0.15, 1);
  }

  .rotator .word.is-on {
    opacity: 1;
    filter: none;
    transform: none;
    transition-delay: 0.12s;
  }

  .rotator .word.is-out {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(-70%);
  }

  /* The recording sits on the wallpaper like a window */
  .video-frame {
    overflow: hidden;
    border-radius: 16px;
    background: #0c1116;
    border: 1px solid rgb(255 255 255 / 0.42);
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.5);
  }

  .video-toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: #10202a;
    background: rgb(255 255 255 / 0.86);
    box-shadow: 0 4px 14px -6px rgb(0 0 0 / 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .video-frame:hover .video-toggle,
  .video-toggle:focus-visible,
  .video-toggle[data-paused="true"] {
    opacity: 1;
  }

  .video-toggle .i-play,
  .video-toggle[data-paused="true"] .i-pause {
    display: none;
  }

  .video-toggle[data-paused="true"] .i-play {
    display: block;
  }

  @media (max-width: 639px) {
    .video-frame {
      border-radius: 12px;
    }

    .video-toggle {
      right: 10px;
      bottom: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotator .word,
    .video-toggle {
      transition: none;
    }
  }
</style>

<script>
  import { labelDownloadButtons } from "@/lib/platform";

  labelDownloadButtons();

  // Cycle the headline's last line. The word leaving rolls up and out; the next rolls in from below.
  const rotator = document.querySelector<HTMLElement>("[data-rotator]");
  if (rotator && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const words = [...rotator.querySelectorAll<HTMLElement>(".word")];
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      const prev = words[i];
      i = (i + 1) % words.length;
      prev.classList.replace("is-on", "is-out");
      words[i].classList.add("is-on");
      // back below the line, unseen, ready for its next turn
      setTimeout(() => prev.classList.remove("is-out"), 650);
    }, 2600);
  }

  const video = document.querySelector<HTMLVideoElement>("[data-demo-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-video-toggle]");
  if (video && toggle) {
    const sync = () => {
      toggle.dataset.paused = String(video.paused);
      toggle.setAttribute("aria-label", video.paused ? "Play video" : "Pause video");
    };
    // Respect reduced motion: show the poster and let the visitor start it
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.pause();
    }
    toggle.addEventListener("click", () => (video.paused ? video.play() : video.pause()));
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    sync();
  }
</script>
