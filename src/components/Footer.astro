---
import Logo from "@/components/Logo.astro";

const repo = "https://github.com/abhee235/headlessos";
const columns = [
  {
    title: "Product",
    links: [
      { label: "Download", href: "/download" },
      { label: "How it works", href: "/#how" },
      { label: "Apps", href: "/#apps" },
      { label: "Changelog", href: `${repo}/blob/main/CHANGELOG.md` },
    ],
  },
  {
    title: "Docs",
    links: [
      { label: "Introduction", href: "/docs/introduction" },
      { label: "Quick start", href: "/docs/getting-started" },
      { label: "Architecture", href: "/docs/concepts/architecture" },
      { label: "Security model", href: "/docs/concepts/security" },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "GitHub", href: repo },
      { label: "Issues", href: `${repo}/issues` },
      { label: "Discussions", href: `${repo}/discussions` },
      { label: "Contributing", href: "/docs/contributing" },
    ],
  },
];
---

<footer class="border-t border-border">
  <div class="container-x grid gap-12 py-16 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="max-w-xs">
      <Logo class="h-7 w-auto" />
      <p class="mt-4 text-sm leading-relaxed text-fg-muted">
        A desktop for your VPS and servers. Runs on your computer, talks plain SSH, installs nothing.
      </p>
    </div>
    {
      columns.map((c) => (
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">{c.title}</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {c.links.map((l) => (
              <li>
                <a href={l.href} class="text-fg-muted transition-colors hover:text-fg">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container-x">
    <div class="flex flex-col gap-2 border-t border-border py-6 text-xs text-fg-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} HeadlessOS · MIT licensed</p>
      <p>For people who like their servers boring and their tools beautiful.</p>
    </div>
  </div>
</footer>
