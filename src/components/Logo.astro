---
// The HeadlessOS mark + wordmark. Text follows currentColor; "OS" uses the brand cyan.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 220 48" class={className} role="img" aria-label="HeadlessOS">
  <defs>
    <linearGradient id={`${id}a`} x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#00D4FF"></stop>
      <stop offset="100%" stop-color="#7C3AED"></stop>
    </linearGradient>
    <linearGradient id={`${id}b`} x1="0" y1="0" x2="0" y2="22" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.3"></stop>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"></stop>
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="44" height="44" rx="11" fill={`url(#${id}a)`}></rect>
  <rect x="2" y="2" width="44" height="22" rx="11" fill={`url(#${id}b)`}></rect>
  <circle cx="24" cy="24" r="12.5" fill="none" stroke="#FFFFFF" stroke-opacity="0.18" stroke-width="2"></circle>
  <path d="M 32.84 32.84 A 12.5 12.5 0 1 1 32.84 15.16" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"></path>
  <circle cx="32.84" cy="15.16" r="1.6" fill="#FFFFFF"></circle>
  <g fill="#FFFFFF">
    <rect x="18.6" y="17.7" width="2.2" height="12.6" rx="0.8"></rect>
    <rect x="27.4" y="17.7" width="2.2" height="12.6" rx="0.8"></rect>
    <rect x="18.6" y="23.0" width="11" height="2.2" rx="0.8"></rect>
  </g>
  <text x="58" y="32" font-family="Geist, Inter, system-ui, sans-serif" font-size="22" font-weight="650" letter-spacing="-0.4" fill="currentColor">
    Headless<tspan fill="#00D4FF">OS</tspan>
  </text>
</svg>
