---
// Two ways in: the desktop app, or the source in your browser. Tinted tiles with white cards, like the
// sections above, and the commands in a light card instead of a black terminal.
import iconTerminal from "@/assets/icons/terminal.svg";

const appSteps = [
  { t: "Download", d: "Pick your platform. It's one installer, no sign-up." },
  { t: "Add your VPS or server", d: "Host, user, and a key, agent or password." },
  { t: "You're in", d: "Your server opens as a desktop. That's it." },
];
---

<section id="get-started" class="sect container-x">
  <div class="section-head">
    <h2 class="h2 max-w-[11em]">Your first server, <span class="block">in about a minute.</span></h2>
    <p class="lede">Install the app like any other, or run it from source and use it in your browser.</p>
  </div>

  <div class="flex flex-wrap gap-5">
    <article class="flex min-w-0 flex-[1_1_420px] flex-col rounded-[24px] bg-tint p-7 sm:p-9">
      <h3 class="h3">Install it like any other app</h3>
      <p class="mt-2.5 mb-7 max-w-[23em] text-fg-muted">For Windows, macOS and Linux. No account, and nothing on the server.</p>
      <ol class="card py-1.5">
        {
          appSteps.map((s, i) => (
            <li class:list={["flex gap-3.5 px-[18px] py-3.5", { "border-b-[0.5px] border-ink/10": i < appSteps.length - 1 }]}>
              <span class="step-num">{i + 1}</span>
              <div>
                <p class="text-[15px] font-semibold">{s.t}</p>
                <p class="mt-0.5 text-[14.5px] text-fg-muted">{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="mt-auto pt-8">
        <a href="/download" class="btn btn-primary btn-lg w-full sm:w-auto" data-download-cta>
          <span data-download-label>Download free</span>
        </a>
      </div>
    </article>

    <article class="flex min-w-0 flex-[1_1_420px] flex-col rounded-[24px] bg-tint p-7 sm:p-9">
      <h3 class="h3">Or run it in your browser</h3>
      <p class="mt-2.5 mb-7 max-w-[23em] text-fg-muted">Needs Node.js 20 or later. Everything stays on localhost.</p>
      <div class="card overflow-hidden">
        <div class="flex items-center gap-2.5 border-b-[0.5px] border-ink/10 py-2.5 pr-2.5 pl-[18px]">
          <img src={iconTerminal.src} alt="" width="20" height="20" />
          <span class="text-sm font-[650]">Terminal</span>
          <button type="button" class="copy-btn ml-auto" data-copy aria-label="Copy commands">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
            <span data-copy-label>Copy</span>
          </button>
        </div>
        <pre class="overflow-x-auto px-[18px] py-3.5 font-mono text-[13px] leading-[1.95]" data-copy-source><span class="text-fg-subtle">$</span> git clone https://github.com/abhee235/headlessos.git
<span class="text-fg-subtle">$</span> cd headlessos && npm install
<span class="text-fg-subtle">$</span> npm run dev
<span class="text-fg-subtle">→</span> <span class="text-fg-muted">open</span> <span class="text-accent-text">http://localhost:3000</span></pre>
      </div>
      <div class="mt-auto flex flex-wrap gap-3 pt-8">
        <a href="/docs/getting-started" class="btn btn-secondary btn-lg">Read the quick start</a>
        <a href="https://github.com/abhee235/headlessos" class="btn btn-ghost btn-lg" target="_blank" rel="noopener">View the code</a>
      </div>
    </article>
  </div>
</section>

<style>
  .step-num {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    margin-top: 1px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--color-accent-text);
    background: var(--color-accent-soft);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 560;
    color: var(--color-fg-muted);
    background: rgb(var(--ink) / 0.05);
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .copy-btn:hover {
    color: var(--color-fg);
    background: rgb(var(--ink) / 0.09);
  }
</style>

<script>
  import { labelDownloadButtons } from "@/lib/platform";

  labelDownloadButtons();

  const btn = document.querySelector<HTMLButtonElement>("[data-copy]");
  const src = document.querySelector("[data-copy-source]");
  btn?.addEventListener("click", async () => {
    const text = (src?.textContent ?? "")
      .split("\n")
      .filter((l) => l.startsWith("$ "))
      .map((l) => l.slice(2))
      .join("\n");
    try {
      await navigator.clipboard.writeText(text);
      const label = btn.querySelector("[data-copy-label]");
      if (label) {
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = "Copy"), 1600);
      }
    } catch {
      /* clipboard blocked: the commands are still selectable */
    }
  });
</script>
