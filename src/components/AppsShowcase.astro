---
// Every app, one at a time: a list of apps on a white card, the app itself next to it, in the page's theme.
// The list advances on its own while the section is on screen; a click or arrow key takes over.
import ThemedShot from "@/components/ThemedShot.astro";
import iconDash from "@/assets/icons/sysdash.svg";
import iconHome from "@/assets/icons/home.svg";
import iconFiles from "@/assets/icons/files.svg";
import iconDocker from "@/assets/icons/docker.svg";
import iconTasks from "@/assets/icons/activity.svg";
import iconTerminal from "@/assets/icons/terminal.svg";
import iconAdmin from "@/assets/icons/serveradmin.svg";
import iconSettings from "@/assets/icons/settings.svg";
import dashL from "@/assets/app/light/dashboard.webp";
import dashD from "@/assets/app/dark/dashboard.webp";
import homeL from "@/assets/app/light/home-hub.webp";
import homeD from "@/assets/app/dark/home-hub.webp";
import filesL from "@/assets/app/light/files.webp";
import filesD from "@/assets/app/dark/files.webp";
import dockerL from "@/assets/app/light/docker.webp";
import dockerD from "@/assets/app/dark/docker.webp";
import tasksL from "@/assets/app/light/task-manager.webp";
import tasksD from "@/assets/app/dark/task-manager.webp";
import termL from "@/assets/app/light/terminal.webp";
import termD from "@/assets/app/dark/terminal.webp";
import adminL from "@/assets/app/light/server-admin.webp";
import adminD from "@/assets/app/dark/server-admin.webp";
import persL from "@/assets/app/light/personalize.webp";
import persD from "@/assets/app/dark/personalize.webp";

const apps = [
  {
    id: "dashboard",
    name: "Dashboard",
    icon: iconDash,
    light: dashL,
    dark: dashD,
    alt: "The Dashboard for web-01: processor, memory, uptime, disk usage and live network traffic",
    body: "Processor, memory, disks, network and uptime on one live screen: the first thing you open when something feels slow.",
  },
  {
    id: "home",
    name: "Home hub",
    icon: iconHome,
    light: homeL,
    dark: homeD,
    alt: "The Home hub for web-01: server health, recent apps, weather and live network traffic",
    body: "One glance at the server you're on: health, live network traffic, recent apps, and the other servers in your session bar.",
  },
  {
    id: "files",
    name: "Files",
    icon: iconFiles,
    light: filesL,
    dark: filesD,
    alt: "File Explorer with compose.yml from /srv/app open in the code editor",
    body: "Browse, upload, rename and edit over SFTP. A real code editor with syntax highlighting, two-pane mode, drag-and-drop uploads, and a recycle bin you can restore from.",
  },
  {
    id: "docker",
    name: "Docker",
    icon: iconDocker,
    light: dockerL,
    dark: dockerD,
    alt: "The Docker app listing six containers with their image, state, status and ports",
    body: "Containers, images, ports and logs at a glance. Start, stop and restart without remembering a single flag.",
  },
  {
    id: "tasks",
    name: "Task Manager",
    icon: iconTasks,
    light: tasksL,
    dark: tasksD,
    alt: "Task Manager listing processes with their user, CPU and memory, above CPU, memory and network totals",
    body: "Live CPU, memory, disk and network, plus every process with who owns it and what it costs.",
  },
  {
    id: "terminal",
    name: "Terminal",
    icon: iconTerminal,
    light: termL,
    dark: termD,
    alt: "A Terminal on web-01 showing uptime, the Docker containers, disk space and the nginx service status",
    body: "When you want the shell, it's one click away: a real terminal with a persistent session, tabs and your own theme.",
  },
  {
    id: "admin",
    name: "Server Admin",
    icon: iconAdmin,
    light: adminL,
    dark: adminD,
    alt: "Server Admin on the Network page, listing listening ports with the process behind each",
    body: "Network, firewall, services, packages, cron, logs and storage: the admin chores, as forms and tables instead of man pages.",
  },
  {
    id: "personalize",
    name: "Personalize",
    icon: iconSettings,
    light: persL,
    dark: persD,
    alt: "Settings on the Wallpaper page, with the system wallpapers to choose from",
    body: "Wallpapers, accent colours, light or dark, terminal themes and shortcuts. Give each server its own look, so you always know which one you're on.",
  },
];
---

<section id="apps" class="sect container-x">
  <div class="section-head">
    <h2 class="h2 max-w-[10em]">Everything you SSH in for, already open.</h2>
    <p class="lede">
      Each app runs the commands you'd type and shows the answer as an interface. Windows move, resize, snap and
      remember where you put them.
    </p>
  </div>

  <div class="tour rounded-[24px] bg-tint p-3.5 sm:p-7 lg:p-9" data-tabs>
    <!-- The app list: a white card of rows on wide screens, a sideways row of chips on narrow ones -->
    <div class="tabs-scroll">
      <div role="tablist" aria-label="HeadlessOS apps" class="tabs card">
        {
          apps.map((a, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${a.id}`}
              aria-controls={`panel-${a.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="tab"
            >
              <img src={a.icon.src} alt="" width="22" height="22" />
              <span>{a.name}</span>
              <span class="tab-progress" aria-hidden="true" />
            </button>
          ))
        }
      </div>
    </div>

    <div class="screens">
      {
        apps.map((a, i) => (
          <div role="tabpanel" id={`panel-${a.id}`} aria-labelledby={`tab-${a.id}`} class="screen" data-active={i === 0 ? "true" : "false"}>
            <ThemedShot
              light={a.light}
              dark={a.dark}
              alt={a.alt}
              sizes="(min-width: 1200px) 800px, 92vw"
              eager={i === 0}
              class="block h-auto w-full"
            />
          </div>
        ))
      }
    </div>

    <div class="captions">
      {
        apps.map((a, i) => (
          <p class="caption text-[15px] leading-relaxed text-fg-muted" data-active={i === 0 ? "true" : "false"}>
            <span class="font-semibold text-fg">{a.name}.</span> {a.body}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Narrow: chips, then the picture, then the caption. Wide: list and caption on the left, picture on the right. */
  .tour {
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr);
  }

  .tabs-scroll {
    position: relative; /* offsetParent for the tabs, so offsetLeft is measured in the row */
    display: flex;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs-scroll::-webkit-scrollbar {
    display: none;
  }

  .tabs {
    display: inline-flex;
    gap: 2px;
    padding: 5px;
    border-radius: 999px;
  }

  .tab {
    position: relative;
    overflow: hidden;
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 14px 0 10px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 560;
    white-space: nowrap;
    color: var(--color-fg-muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .tab img {
    width: 20px;
    height: 20px;
  }

  .tab:hover {
    color: var(--color-fg);
    background: rgb(var(--ink) / 0.04);
  }

  .tab[aria-selected="true"] {
    color: var(--color-accent-text);
    background: var(--color-accent-soft);
  }

  .tab-progress {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    opacity: 0.45;
    transform: scaleX(0);
    transform-origin: left;
  }

  [data-tabs][data-auto="true"] .tab[aria-selected="true"] .tab-progress {
    animation: progress var(--tab-ms, 6000ms) linear forwards;
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  .screens {
    display: grid;
    min-width: 0;
  }

  .screen {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s ease,
      visibility 0s linear 0.45s;
  }

  .screen[data-active="true"] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s ease;
  }

  .screen :global(img) {
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgb(var(--ink) / 0.08),
      0 24px 48px -28px rgb(10 30 40 / 0.45);
  }

  .captions {
    display: grid;
  }

  .caption {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .caption[data-active="true"] {
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .tour {
      grid-template-columns: 236px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 36px;
      row-gap: 24px;
    }

    .tabs-scroll {
      grid-column: 1;
      grid-row: 1;
      overflow: visible;
    }

    .tabs {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 2px;
      padding: 8px;
      border-radius: 18px;
    }

    .tab {
      height: 44px;
      padding: 0 14px 0 10px;
      border-radius: 12px;
      font-size: 0.95rem;
    }

    .tab img {
      width: 24px;
      height: 24px;
    }

    .tab-progress {
      left: 12px;
      right: 12px;
      bottom: 5px;
    }

    .screens {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
    }

    .captions {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
      padding-inline: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen,
    .caption {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-tabs]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const captions = [...root.querySelectorAll<HTMLElement>(".caption")];
    const scroller = root.querySelector<HTMLElement>(".tabs-scroll");
    const DWELL = 6000;
    let current = 0;
    let timer: number | undefined;

    const select = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, j) => {
        const on = j === current;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].dataset.active = String(on);
        captions[j].dataset.active = String(on);
      });
      if (focus) tabs[current].focus({ preventScroll: true });
      // Keep the active chip visible when the row scrolls sideways on phones (never scroll the page)
      if (scroller && scroller.scrollWidth > scroller.clientWidth) {
        const t = tabs[current];
        scroller.scrollTo({ left: t.offsetLeft - (scroller.clientWidth - t.offsetWidth) / 2, behavior: "smooth" });
      }
    };

    const stopAuto = () => {
      window.clearInterval(timer);
      timer = undefined;
      root.dataset.auto = "false";
    };

    const startAuto = () => {
      if (timer || root.dataset.stopped === "true") return;
      root.style.setProperty("--tab-ms", `${DWELL}ms`);
      root.dataset.auto = "true";
      timer = window.setInterval(() => select(current + 1), DWELL);
    };

    tabs.forEach((t, i) =>
      t.addEventListener("click", () => {
        root.dataset.stopped = "true";
        stopAuto();
        select(i);
      }),
    );

    root.querySelector('[role="tablist"]')?.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      const next = k === "ArrowRight" || k === "ArrowDown";
      const prev = k === "ArrowLeft" || k === "ArrowUp";
      if (!next && !prev && k !== "Home" && k !== "End") return;
      e.preventDefault();
      root.dataset.stopped = "true";
      stopAuto();
      if (next) select(current + 1, true);
      if (prev) select(current - 1, true);
      if (k === "Home") select(0, true);
      if (k === "End") select(tabs.length - 1, true);
    });

    // Advance on its own only while on screen, and never for reduced motion
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!calm && "IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? startAuto() : stopAuto()), {
        threshold: 0.35,
      }).observe(root);
    }
  }
</script>
