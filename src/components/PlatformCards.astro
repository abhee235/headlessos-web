---
// The download cards, one per platform. Links start at the GitHub releases page and are upgraded to
// the latest release's files when the GitHub API answers, and the visitor's own platform is marked.
// Used by /download and by the landing page's closing section, so both offer the same thing.
interface Props {
  /** Classes for the grid around the cards */
  class?: string;
  /** Where "Run it from source" points when a platform has no files in the release */
  sourceHref?: string;
  /** The platform names' heading level, one below the heading the cards sit under */
  heading?: "h2" | "h3";
}

const { class: className, sourceHref = "#source", heading: Heading = "h2" } = Astro.props;

const releases = "https://github.com/abhee235/headlessos/releases/latest";

const platforms = [
  {
    id: "windows",
    name: "Windows",
    req: "Windows 10 or 11 · 64-bit",
    icon: '<path fill="currentColor" stroke="none" d="M3 5.5l7.5-1v7H3v-6zm0 13l7.5 1v-7H3v6zm8.5 1.2L21 21v-8.5h-9.5v7.2zm0-15.4v7.2H21V3l-9.5 1.3z"/>',
    primary: { key: "win-setup", label: "Installer", ext: ".exe" },
    secondary: { key: "win-portable", label: "Portable", ext: ".exe" },
    note: "Builds aren't code-signed yet, so SmartScreen may warn on first run. Choose More info, then Run anyway.",
  },
  {
    id: "mac",
    name: "macOS",
    req: "macOS 11 or later · Apple silicon & Intel",
    icon: '<path fill="currentColor" stroke="none" d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.1-1.2 2.9-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.4-.9-2.4-3.8zM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4z"/>',
    primary: { key: "mac-dmg", label: "Disk image", ext: ".dmg" },
    secondary: { key: "mac-zip", label: "Zip", ext: ".zip" },
    note: "The app isn't notarized yet. If macOS blocks it, open System Settings → Privacy & Security and choose Open Anyway. If it says the app is damaged, run xattr -cr /Applications/HeadlessOS.app in Terminal.",
  },
  {
    id: "linux",
    name: "Linux",
    req: "64-bit · most desktop distributions",
    icon: '<path d="M4 17l6-6-6-6M12 19h8"/>',
    primary: { key: "linux-appimage", label: "AppImage", ext: ".AppImage" },
    secondary: { key: "linux-deb", label: "Debian / Ubuntu", ext: ".deb" },
    note: "Make the AppImage executable (chmod +x) and run it, or install the .deb with your package manager.",
  },
];
---

<div class={className}>
  {
    platforms.map((p, i) => (
      <article id={p.id} class="rv card platform flex scroll-mt-28 flex-col p-7 sm:p-8" style={`--d:${0.06 * i}s`} data-platform={p.id}>
        <div class="flex items-start justify-between">
          <span class="icon-tile !h-12 !w-12 [--tile:var(--color-fg-muted)]">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
          </span>
          <span class="mine-badge chip" hidden data-mine-badge>
            For this computer
          </span>
        </div>
        <Heading class="mt-6 text-2xl font-semibold tracking-tight">{p.name}</Heading>
        <p class="mt-1 text-sm text-fg-subtle">{p.req}</p>

        <div class="mt-8 flex flex-col gap-2.5">
          <a href={releases} class="btn btn-primary btn-lg justify-between" data-asset={p.primary.key}>
            <span class="flex items-center gap-2.5">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19.5h14" /></svg>
              {p.primary.label}
            </span>
            <span class="font-mono text-xs opacity-60" data-asset-meta>{p.primary.ext}</span>
          </a>
          <a href={releases} class="btn btn-secondary btn-lg justify-between" data-asset={p.secondary.key}>
            <span>{p.secondary.label}</span>
            <span class="font-mono text-xs text-fg-subtle" data-asset-meta>{p.secondary.ext}</span>
          </a>
        </div>
        <p class="missing mt-4 hidden text-sm text-fg-muted" data-missing>
          Not in this release yet. <a href={sourceHref} class="text-fg underline decoration-ink/30 underline-offset-4">Run it from source</a> in the meantime.
        </p>
        <p class="mt-auto pt-8 text-sm leading-relaxed text-fg-subtle" data-note>{p.note}</p>
      </article>
    ))
  }
</div>

<style>
  /* A file's name and size share a line when they fit. In a narrow card (a phone, or three across
     at 1024px) the size wraps under the name instead of being cut off. */
  .platform .btn {
    flex-wrap: wrap;
    row-gap: 0.2rem;
    height: auto;
    min-height: 52px;
    padding-block: 0.6rem;
    line-height: 1.2;
  }

  /* The visitor's own platform: an accent ring */
  .platform[data-mine="true"] {
    box-shadow:
      0 0 0 2px var(--color-accent),
      var(--card-shadow);
  }

  .platform:not([data-mine="true"]) .btn-primary {
    background: rgb(var(--ink) / 0.08);
    color: var(--color-fg);
    text-shadow: none;
    border-color: transparent;
    box-shadow: 0 0 0 1px var(--color-border-strong) inset;
  }

  /* The muted buttons drop the glossy sheen of the lit one */
  .platform:not([data-mine="true"]) .btn-primary::before {
    display: none;
  }

  .platform:not([data-mine="true"]) .btn-primary:hover {
    background: rgb(var(--ink) / 0.12);
  }

  .platform[data-unavailable="true"] [data-asset],
  .platform[data-unavailable="true"] [data-note],
  [data-asset][data-absent="true"] {
    display: none;
  }

  .platform[data-unavailable="true"] [data-missing] {
    display: block;
  }

  .mine-badge {
    color: var(--color-accent-text);
    border-color: rgb(106 79 176 / 0.3);
    background: var(--color-accent-soft);
  }
</style>

<script>
  import { detectOS } from "@/lib/platform";

  // Highlight the visitor's platform
  const os = detectOS();
  if (os) {
    const card = document.querySelector<HTMLElement>(`[data-platform="${os}"]`);
    if (card) {
      card.dataset.mine = "true";
      card.querySelector<HTMLElement>("[data-mine-badge]")?.removeAttribute("hidden");
    }
  }

  type Asset = { name: string; browser_download_url: string };
  type Release = { tag_name: string; published_at: string; html_url: string; assets: Asset[] };

  const MATCH: Record<string, (n: string) => boolean> = {
    "win-setup": (n) => /setup.*\.exe$/i.test(n),
    "win-portable": (n) => /\.exe$/i.test(n) && !/setup/i.test(n),
    "mac-dmg": (n) => /\.dmg$/i.test(n),
    "mac-zip": (n) => /mac.*\.zip$/i.test(n),
    "linux-appimage": (n) => /\.appimage$/i.test(n),
    "linux-deb": (n) => /\.deb$/i.test(n),
  };

  fetch("https://api.github.com/repos/abhee235/headlessos/releases/latest", {
    headers: { Accept: "application/vnd.github+json" },
  })
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((rel: Release) => {
      // The download page's "Latest: v…" line; other pages don't have one
      const line = document.querySelector("[data-release-line]");
      if (line) {
        const date = new Date(rel.published_at).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
        line.innerHTML = `Latest: <a class="text-fg-muted underline decoration-ink/25 underline-offset-4 hover:text-fg" href="${rel.html_url}">${rel.tag_name}</a> · ${date}`;
      }
      document.querySelectorAll<HTMLAnchorElement>("[data-asset]").forEach((a) => {
        const asset = rel.assets.find((x) => MATCH[a.dataset.asset!]?.(x.name));
        if (!asset) {
          a.dataset.absent = "true";
          return;
        }
        // The card shows the file type, not its size, which changes with every release
        a.href = asset.browser_download_url;
      });
      // A platform with no files in this release points to the source instead
      document.querySelectorAll<HTMLElement>("[data-platform]").forEach((card) => {
        const links = card.querySelectorAll<HTMLAnchorElement>("[data-asset]");
        if ([...links].every((a) => a.dataset.absent === "true")) card.dataset.unavailable = "true";
      });
    })
    .catch(() => {
      /* Rate-limited or offline: the buttons keep pointing at the releases page */
    });
</script>
