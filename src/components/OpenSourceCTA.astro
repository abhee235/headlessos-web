---
// Closing call to action, on the app's Mist wallpaper, with a way in for each platform.
import { Image } from "astro:assets";
import mist from "@/assets/wallpapers/mist.jpg";

const platforms = [
  { id: "windows", name: "Windows", detail: "Windows 10 or 11, 64-bit. Installer or portable .exe." },
  { id: "mac", name: "macOS", detail: "macOS 11 or later, Apple silicon and Intel. A .dmg or .zip." },
  { id: "linux", name: "Linux", detail: "64-bit. An AppImage, or a .deb for Debian and Ubuntu." },
];
---

<section class="band scope-light mt-[clamp(64px,7vw,100px)] mb-[clamp(72px,9vw,120px)]" aria-labelledby="cta-title">
  <Image src={mist} alt="" widths={[960, 1600, 2400]} sizes="100vw" class="band-media object-top" />
  <div aria-hidden="true" class="fog"></div>

  <div class="flex flex-col items-center px-5 pt-[clamp(64px,7.6vw,104px)] text-center">
    <h2 id="cta-title" class="h2 max-w-[12em] !text-[clamp(2.4rem,4.8vw,4.1rem)]">Give every server a desktop.</h2>
    <p class="mt-4 max-w-[30rem] text-[clamp(1.06rem,1.4vw,1.2rem)] leading-relaxed text-fg-muted">
      Free and open source. Download the app, add your VPS, and see it the way you see your own computer.
    </p>
    <div class="mt-8 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row">
      <a href="/download" class="btn btn-primary btn-lg w-full sm:w-auto" data-download-cta>
        <span data-download-label>Download free</span>
      </a>
      <a href="https://github.com/abhee235/headlessos" target="_blank" rel="noopener" class="btn btn-secondary btn-lg w-full sm:w-auto">
        Star on GitHub
      </a>
    </div>
  </div>

  <ul class="mx-auto mt-[clamp(44px,5vw,72px)] grid max-w-[1120px] grid-cols-1 gap-4 px-[clamp(16px,3vw,24px)] pb-[clamp(16px,3vw,24px)] md:grid-cols-3">
    {
      platforms.map((p) => (
        <li>
          <a href={`/download#${p.id}`} class="card group flex h-full flex-col gap-2 p-6 transition-transform hover:-translate-y-0.5">
            <span class="flex items-center justify-between text-[1.15rem] font-semibold">
              {p.name}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-text" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
            <span class="text-[0.98rem] leading-relaxed text-fg-muted">{p.detail}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Lifts the top of the mist a little, so the dark title always has a light ground */
  .fog {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(246 248 248 / 0.7) 0%, rgb(246 248 248 / 0.45) 38%, rgb(246 248 248 / 0) 62%);
  }
</style>

<script>
  import { labelDownloadButtons } from "@/lib/platform";

  labelDownloadButtons();
</script>
