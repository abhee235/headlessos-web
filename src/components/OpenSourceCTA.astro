---
// Closing call to action
---

<section class="relative pb-28 pt-8 sm:pb-36">
  <div class="container-x">
    <div class="rv cta relative isolate overflow-hidden rounded-[28px] border border-border px-6 py-16 text-center sm:px-12 sm:py-24">
      <div aria-hidden="true" class="cta-glow"></div>
      <div aria-hidden="true" class="bg-grid absolute inset-0 -z-10 opacity-60"></div>
      <h2 class="h2 mx-auto max-w-3xl">Give every server a desktop.</h2>
      <p class="lede mx-auto mt-6 max-w-xl">
        Free and open source. Download the app, add your VPS, and see it the way you see your own computer.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/download" class="btn btn-primary btn-lg w-full sm:w-auto" data-download-cta>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path></svg>
          <span data-download-label>Download free</span>
        </a>
        <a href="https://github.com/abhee235/headlessos" target="_blank" rel="noopener" class="btn btn-secondary btn-lg w-full sm:w-auto">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.53L12 17.5l-5.87 3.07 1.12-6.53L2.5 9.41l6.56-.95L12 2.5z"></path></svg>
          Star on GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
  }

  .cta-glow {
    position: absolute;
    left: 50%;
    bottom: -55%;
    width: 120%;
    height: 100%;
    transform: translateX(-50%);
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(0, 212, 255, 0.35), transparent 55%),
      radial-gradient(ellipse at 35% 10%, rgba(124, 58, 237, 0.4), transparent 55%);
    filter: blur(50px);
    z-index: -1;
  }
</style>

<script>
  import { labelDownloadButtons } from "@/lib/platform";

  labelDownloadButtons();
</script>
