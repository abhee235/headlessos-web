---
// "Not an operating system": where HeadlessOS runs, and what it does to the server (nothing).
const steps = [
  {
    where: "On your computer",
    title: "HeadlessOS runs here",
    body: "As a desktop app for Windows, macOS or Linux, or in your browser on localhost. The windows, the parsing and the AI all live on your side.",
  },
  {
    where: "Over SSH",
    title: "It signs in like you do",
    body: "With the key, agent or password you already use, on the port you already have open. No agent, no new port, no account.",
  },
  {
    where: "On your server",
    title: "It stays exactly as it was",
    body: "A VPS, a cloud server, a home-lab box or a Raspberry Pi: any Linux machine you can reach. Close HeadlessOS, and nothing is left behind.",
  },
];
const commands = ["ls", "df", "ps", "ss", "docker", "systemctl", "journalctl", "ufw"];
---

<section id="how" class="sect container-x">
  <div class="section-head">
    <h2 class="h2 max-w-[8em]">It runs on your computer, not your server.</h2>
    <p class="lede">
      HeadlessOS isn't an operating system. It's an app that signs in to your server over SSH, runs the same commands
      you would, and turns the answers into windows. Your server keeps its own OS, packages and config.
    </p>
  </div>

  <ol class="mat grid grid-cols-1 lg:grid-cols-3">
    {
      steps.map((s, i) => (
        <li class="step relative p-6 sm:p-9">
          {i > 0 && (
            <span class="step-arrow" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          )}
          <p class="text-sm font-semibold text-accent-text">{s.where}</p>
          <h3 class="mt-2 text-[19px] font-[650] tracking-[-0.012em]">{s.title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-fg-muted">{s.body}</p>
          {i === 2 && (
            <div class="mt-5 flex flex-wrap gap-1.5">
              {commands.map((c) => (
                <span class="kbd text-fg-muted">{c}</span>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* The three steps share one tinted panel, split by a groove in the page colour */
  .step + .step {
    border-top: 1px solid var(--color-bg);
  }

  .step-arrow {
    position: absolute;
    left: 50%;
    top: 0;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    color: var(--color-accent-text);
    background: var(--card-bg);
    box-shadow: 0 2px 8px -3px rgb(10 30 40 / 0.3);
    transform: translate(-50%, -50%) rotate(90deg);
  }

  @media (min-width: 1024px) {
    .step + .step {
      border-top: 0;
      border-left: 1px solid var(--color-bg);
    }

    .step-arrow {
      left: 0;
      top: 50%;
      transform: translate(-50%, -50%);
    }
  }
</style>
