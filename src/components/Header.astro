---
import Logo from "@/components/Logo.astro";

const navLinks = [
  { label: "How it works", href: "/#how" },
  { label: "Apps", href: "/#apps" },
  { label: "Features", href: "/#features" },
  { label: "Docs", href: "/docs/introduction" },
  { label: "Blog", href: "/blog" },
];
---

<header class="site-header sticky top-0 z-50">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="shrink-0" aria-label="HeadlessOS home">
      <Logo class="h-7 w-auto" />
    </a>

    <nav class="hidden items-center gap-1 text-sm md:flex" aria-label="Main">
      {
        navLinks.map((l) => (
          <a href={l.href} class="btn btn-ghost btn-sm font-normal">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" class="btn btn-ghost btn-sm !px-2.5" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
        <!-- moon shows in light (switch to dark), sun shows in dark (switch to light) -->
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
      </button>
      <a
        href="https://github.com/abhee235/headlessos"
        target="_blank"
        rel="noopener"
        class="btn btn-ghost btn-sm hidden sm:inline-flex"
        aria-label="HeadlessOS on GitHub"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.69-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
      <a href="/download" class="btn btn-primary btn-sm">Download</a>

      <details class="mobile-nav relative md:hidden">
        <summary class="btn btn-ghost btn-sm !px-2.5" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav class="mobile-panel glass-strong" aria-label="Mobile">
          {
            navLinks.map((l) => (
              <a href={l.href} class="block rounded-lg px-3 py-2.5 text-fg-muted hover:bg-ink/5 hover:text-fg">
                {l.label}
              </a>
            ))
          }
          <a href="https://github.com/abhee235/headlessos" class="block rounded-lg px-3 py-2.5 text-fg-muted hover:bg-ink/5 hover:text-fg">
            GitHub
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: rgb(var(--paper) / 0.72);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-bottom: 1px solid rgb(var(--ink) / 0.07);
  }

  .mobile-nav summary {
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  :global(html[data-theme="dark"]) .icon-moon,
  :global(html:not([data-theme="dark"])) .icon-sun {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: 220px;
    padding: 8px;
    border-radius: 16px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    box-shadow: 0 20px 60px -10px var(--shadow-strong);
  }
</style>

<script>
  // Light ⇄ dark. Stored under Starlight's key so the docs follow the same choice.
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const label = () => {
    const dark = document.documentElement.dataset.theme === "dark";
    toggle?.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
  };
  label();
  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("starlight-theme", next);
    } catch {
      /* storage blocked: the switch still applies to this page */
    }
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", next === "dark" ? "#07080c" : "#f7f8fa");
    label();
  });
</script>
