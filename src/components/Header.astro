---
import SiteBar from "@/components/SiteBar.astro";
import { navLinks, githubUrl } from "@/data/nav";
---

<header class="site-header sticky top-0 z-50">
  <div class="container-x h-16">
    <SiteBar>
      <details slot="menu" class="mobile-nav relative">
        <summary class="btn btn-ghost btn-sm !px-2.5" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav class="mobile-panel glass-strong" aria-label="Mobile">
          {
            navLinks.map((l) => (
              <a href={l.href} class="block rounded-lg px-3 py-2.5 text-fg-muted hover:bg-ink/5 hover:text-fg">
                {l.label}
              </a>
            ))
          }
          <a href={githubUrl} class="block rounded-lg px-3 py-2.5 text-fg-muted hover:bg-ink/5 hover:text-fg">
            GitHub
          </a>
          <a href="/download" class="menu-download block rounded-lg px-3 py-2.5 text-fg-muted hover:bg-ink/5 hover:text-fg">
            Download
          </a>
        </nav>
      </details>
    </SiteBar>
  </div>
</header>

<style>
  .site-header {
    background: rgb(var(--paper) / 0.8);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-bottom: 0.5px solid rgb(var(--ink) / 0.1);
  }

  .mobile-nav summary {
    list-style: none;
  }

  /* The menu holds what the bar has no room for: the links below 60rem (SiteBar shows them from
     there), and Download below 25.5rem */
  @media (min-width: 60rem) {
    .mobile-nav {
      display: none;
    }
  }

  @media (min-width: 25.5rem) {
    .menu-download {
      display: none;
    }
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: 220px;
    padding: 8px;
    border-radius: 18px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    box-shadow: 0 20px 60px -10px var(--shadow-strong);
  }
</style>
