---
// The docs header: a way back to the site, a way home to the docs, then search and the theme
import Search from "virtual:starlight/components/Search";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
---

<div class="docs-header">
  <div class="docs-header-start">
    <a href="/" class="docs-back" aria-label="Back to HeadlessOS">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
      <span>Back to HeadlessOS</span>
    </a>
    <span class="docs-rule" aria-hidden="true"></span>
    <a href="/docs" class="docs-home">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 7v14" />
        <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />
      </svg>
      Documentation
    </a>
  </div>
  <div class="docs-header-end">
    <div class="print:hidden"><Search /></div>
    <div class="docs-header-tools print:hidden">
      <SocialIcons />
      <ThemeSelect />
    </div>
  </div>
</div>

<style>
  .docs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .docs-header-start,
  .docs-header-end,
  .docs-header-tools {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .docs-header-start {
    gap: 1.25rem;
  }

  .docs-header-end {
    gap: 1rem;
  }

  .docs-header-tools {
    gap: 0.75rem;
  }

  .docs-back,
  .docs-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    font-size: var(--docs-text-ui);
    text-decoration: none;
  }

  .docs-back {
    font-weight: 500;
    color: var(--sl-color-gray-3);
    transition: color 0.15s ease;
  }

  .docs-back:hover {
    color: var(--sl-color-white);
  }

  .docs-home {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .docs-rule {
    width: 1px;
    height: 1rem;
    flex-shrink: 0;
    background: var(--docs-border);
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .docs-home svg {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--docs-primary);
  }

  /* The phone menu has these */
  @media (max-width: 49.99rem) {
    .docs-header-tools {
      display: none;
    }
  }

  /* There is no room for the words on a phone; the arrow still goes back */
  @media (max-width: 40rem) {
    .docs-back span,
    .docs-rule {
      display: none;
    }

    .docs-header-start {
      gap: 0.75rem;
    }
  }
</style>
