---
// A link to another docs page, as a card
interface Props {
  href: string;
  title: string;
  description?: string;
}

const { href, title, description } = Astro.props;
---

<a href={href} class="doc-card not-content">
  <span class="doc-card-title">
    {title}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
  </span>
  {description && <span class="doc-card-text">{description}</span>}
</a>

<style>
  .doc-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    text-decoration: none;
    background: var(--docs-surface-raised);
    border: 1px solid var(--docs-border);
    border-radius: 0.75rem;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .doc-card:hover {
    border-color: var(--docs-primary);
  }

  .doc-card-title {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--docs-text-body);
    font-weight: 600;
    color: var(--sl-color-white);
    transition: color 0.15s ease;
  }

  .doc-card:hover .doc-card-title {
    color: var(--docs-primary);
  }

  .doc-card-text {
    font-size: var(--docs-text-ui);
    line-height: 1.5;
    color: var(--docs-prose-muted);
  }

  svg {
    width: 1rem;
    height: 1rem;
    margin-top: 0.1875rem;
    flex-shrink: 0;
    fill: none;
    stroke: var(--sl-color-gray-3);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s ease;
  }

  .doc-card:hover svg {
    stroke: var(--docs-primary);
    transform: translateX(2px);
  }
</style>
