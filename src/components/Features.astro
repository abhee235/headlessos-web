---
// Why HeadlessOS: the things that make it safe to point at a real server.
const features = [
  {
    title: "No agent, no new port, no account",
    text: "It uses the tools your server already has, so a fresh VPS works the minute you can SSH into it, and an old one doesn't need touching.",
    icon: '<path d="M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7l8-4z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  },
  {
    title: "Private by default",
    text: "It listens on localhost only, behind a per-install token. Saved passwords are encrypted on your disk. No cloud, no telemetry.",
    icon: '<rect x="4" y="10.5" width="16" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>',
  },
  {
    title: "Every server gets its own desktop",
    text: "Sign in to several at once and switch in a click. Each keeps its windows, wallpaper and layout, and comes back as you left it.",
    icon: '<rect x="3" y="4" width="13" height="10" rx="2"/><path d="M8 18h11a2 2 0 0 0 2-2V9"/>',
  },
  {
    title: "Command output in, interface out",
    text: "31 built-in parsers read df, ps, docker and friends instantly. An AI model only steps in for output they don't recognise.",
    icon: '<path d="M4 17l6-6-6-6M12 19h8"/>',
  },
  {
    title: "Edits you can take back",
    text: "Deleted files go to a recycle bin you can restore from, and files are backed up and checked before a change is kept.",
    icon: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>',
  },
  {
    title: "A real app on every desktop",
    text: "Install it on Windows, macOS or Linux. Prefer the browser? Run it from source and open localhost. Same desktop either way.",
    icon: '<path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19.5h14"/>',
  },
];
---

<section id="features" class="sect container-x" aria-labelledby="features-title">
  <div class="flex flex-wrap gap-x-[72px] gap-y-9">
    <h2 id="features-title" class="h2 max-w-[8em] flex-[1_1_300px]">Made for you, invisible to your server.</h2>
    <div class="grid min-w-0 flex-[2_1_520px] grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-x-12 gap-y-10">
      {
        features.map((f) => (
          <div>
            <div class="icon-tile">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
            </div>
            <h3 class="mt-4 mb-1.5 text-[17.5px] font-[650] tracking-[-0.012em]">{f.title}</h3>
            <p class="text-base leading-relaxed text-fg-muted">{f.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
