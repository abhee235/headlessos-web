---
// The problem, then the answer: what checking on a server takes today, next to the Dashboard.
// Two tiles in the same language as the apps section above: tinted panels, a white card, the app itself.
import ThemedShot from "@/components/ThemedShot.astro";
import dashLight from "@/assets/app/light/dashboard.webp";
import dashDark from "@/assets/app/dark/dashboard.webp";

const commands = [
  "ssh deploy@web-01.example.com",
  "df -h | grep -v tmpfs",
  "free -m",
  "ps aux --sort=-%cpu | head",
  'docker ps --format "table {{.Names}}\\t{{.Status}}"',
  "docker logs --tail 50 app-web",
  "sudo journalctl -u nginx --since -1h | grep err",
  "sudo ss -tulpn",
  "sudo ufw status numbered",
  "crontab -l",
];
---

<section id="why" class="sect container-x">
  <div class="section-head">
    <h2 class="h2 max-w-[11em]">Stop memorizing flags. <span class="block">Look at your server.</span></h2>
    <p class="lede">
      Is the disk full? Which container restarted? What's eating the CPU? Each answer is another command to remember.
      HeadlessOS asks for you and keeps the answers on screen.
    </p>
  </div>

  <div class="flex flex-wrap gap-5">
    <!-- Today: the commands, as a quiet list -->
    <article class="flex min-w-0 flex-[5_1_340px] flex-col rounded-[24px] bg-tint p-7 sm:p-9">
      <h3 class="h3">Today</h3>
      <p class="mt-2.5 mb-7 max-w-[23em] text-fg-muted">Ten commands before coffee, and you still line up the answers in your head.</p>
      <div class="card mt-auto overflow-x-auto py-1.5">
        <ol class="min-w-max font-mono text-[12.5px] leading-snug">
          {
            commands.map((c) => (
              <li class="flex gap-3 border-b-[0.5px] border-ink/10 px-4 py-[7px]">
                <span class="text-fg-subtle select-none" aria-hidden="true">$</span>
                <span>{c}</span>
              </li>
            ))
          }
          <li class="px-4 pt-[7px] pb-1.5 text-fg-subtle"># …and was that on web-01 or web-02?</li>
        </ol>
      </div>
    </article>

    <!-- With HeadlessOS: the Dashboard, resting on the tile's lower edge -->
    <article class="flex min-w-0 flex-[7_1_440px] flex-col overflow-hidden rounded-[24px] bg-tint px-7 pt-7 sm:px-9 sm:pt-9">
      <h3 class="h3">With HeadlessOS</h3>
      <p class="mt-2.5 max-w-[26em] text-fg-muted">One window, live: processor, memory, disks and network, refreshed while you watch.</p>
      <div class="peek mt-auto -mr-7 pt-7 sm:-mr-9">
        <ThemedShot
          light={dashLight}
          dark={dashDark}
          alt="The HeadlessOS Dashboard for web-01, with processor, memory, uptime, disk usage and live network traffic"
          sizes="(min-width: 1200px) 620px, 92vw"
          class="block h-auto w-full"
        />
      </div>
    </article>
  </div>
</section>

<style>
  /* The capture sits on the tile's bottom edge, like a screen seen over a desk */
  .peek {
    margin-bottom: -2px;
  }

  /* It runs off the tile's right and bottom edges, so only the top-left corner is rounded */
  .peek :global(img) {
    border-radius: 14px 0 0 0;
    box-shadow:
      0 0 0 1px rgb(var(--ink) / 0.08),
      0 -10px 40px -18px rgb(10 30 40 / 0.35);
  }
</style>
