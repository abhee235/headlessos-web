---
// The problem, then the answer: what checking on a server looks like today, next to the Dashboard.
import { Image } from "astro:assets";
import dashboard from "@/assets/screens/dashboard.webp";
---

<section id="why" class="section relative">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <p class="rv eyebrow">Before &amp; after</p>
      <h2 class="rv h2 mt-5 [--d:.05s]">
        Stop memorizing flags.
        <span class="dim">Just look at your server.</span>
      </h2>
      <p class="rv lede mx-auto mt-6 max-w-2xl [--d:.1s]">
        "Is the disk full? Which container restarted? What's eating the CPU?" Each answer is another command to
        remember. HeadlessOS asks them for you and keeps the answers on screen.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 items-stretch gap-4 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-6">
      <figure class="rv card flex min-w-0 flex-col p-5 sm:p-6">
        <figcaption class="flex items-center justify-between">
          <span class="font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle">Before</span>
          <span class="font-mono text-xs text-fg-subtle">10 commands before coffee</span>
        </figcaption>
        <pre class="term mt-4 flex-1 !text-[0.78rem] !leading-[2]"><span class="dim">$</span> <span class="hi">ssh deploy@web-01.example.com</span>
<span class="dim">$</span> <span class="hi">df -h | grep -v tmpfs</span>
<span class="dim">$</span> <span class="hi">free -m</span>
<span class="dim">$</span> <span class="hi">ps aux --sort=-%cpu | head</span>
<span class="dim">$</span> <span class="hi">docker ps --format "table &#123;&#123;.Names&#125;&#125;\t&#123;&#123;.Status&#125;&#125;"</span>
<span class="dim">$</span> <span class="hi">docker logs --tail 50 shop-api</span>
<span class="dim">$</span> <span class="hi">sudo journalctl -u nginx --since -1h | grep err</span>
<span class="dim">$</span> <span class="hi">sudo ss -tulpn</span>
<span class="dim">$</span> <span class="hi">sudo ufw status numbered</span>
<span class="dim">$</span> <span class="hi">crontab -l</span>
<span class="dim"># …and was that on web-01 or web-02?</span></pre>
      </figure>

      <figure class="rv flex min-w-0 flex-col [--d:.08s]">
        <figcaption class="mb-4 flex items-center justify-between px-1">
          <span class="font-mono text-xs uppercase tracking-[0.14em] text-brand-300">With HeadlessOS</span>
          <span class="font-mono text-xs text-fg-subtle">one window, live</span>
        </figcaption>
        <div class="frame">
          <Image
            src={dashboard}
            alt="The HeadlessOS Dashboard for web-01: processor, memory, disks, network and uptime on one screen"
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1200px) 680px, 94vw"
            class="frame-media"
          />
        </div>
      </figure>
    </div>
  </div>
</section>
