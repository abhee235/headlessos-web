---
// The header's contents, shared by the site and the docs so they can't drift apart. The docs can't
// load global.css, whose reset would break Starlight, so everything this needs is in this file.
// "tools" holds what a section adds before the theme button; the docs put search there.
import Logo from "@/components/Logo.astro";
import { navLinks, githubUrl } from "@/data/nav";

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes("#") && (path === href || path.startsWith(`${href}/`));
---

<div class="site-bar">
  <a href="/" class="site-bar-logo" aria-label="HeadlessOS home">
    <Logo />
  </a>

  <nav class="site-bar-nav" aria-label="Main">
    {
      navLinks.map((l) => (
        <a href={l.href} class="bar-btn" aria-current={isCurrent(l.href) ? "page" : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <div class="site-bar-end">
    <slot name="tools" />
    <button type="button" class="bar-btn bar-strong bar-icon" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
      <!-- moon shows in light (switch to dark), sun shows in dark (switch to light) -->
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
    </button>
    <a href={githubUrl} target="_blank" rel="noopener" class="bar-btn bar-strong site-bar-github" aria-label="HeadlessOS on GitHub">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.69-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"></path>
      </svg>
      <span>GitHub</span>
    </a>
    <a href="/download" class="bar-btn bar-primary site-bar-download">Download</a>
    <slot name="menu" />
  </div>
</div>

<style>
  .site-bar {
    --bar-fg: #0e1018;
    --bar-bg: #f7f8fa;
    --bar-muted: #4a4f5e;
    --bar-ink: 14 16 24;
    --bar-logo-accent: #0891b2;
    --bar-focus: #0891b2;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  :global(html[data-theme="dark"]) .site-bar {
    --bar-fg: #f4f5f8;
    --bar-bg: #07080c;
    --bar-muted: #a4a8b6;
    --bar-ink: 255 255 255;
    --bar-logo-accent: #00d4ff;
    --bar-focus: #3ddcff;
  }

  .site-bar-logo {
    flex-shrink: 0;
    color: var(--bar-fg);
  }

  .site-bar-logo :global(svg) {
    display: block;
    width: auto;
    height: 1.75rem;
  }

  .site-bar-logo :global(.logo-os) {
    fill: var(--bar-logo-accent);
  }

  .site-bar-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  .site-bar-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    height: 2.25rem;
    padding: 0 0.9rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    color: var(--bar-muted);
    cursor: pointer;
    user-select: none;
    background: transparent;
    border: 0;
    border-radius: 0.625rem;
    transition:
      transform 0.15s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease;
  }

  .bar-btn:hover {
    color: var(--bar-fg);
    background: rgb(var(--bar-ink) / 0.05);
  }

  .bar-btn:active {
    transform: translateY(1px);
  }

  .bar-btn:focus-visible {
    outline: 2px solid var(--bar-focus);
    outline-offset: 3px;
  }

  .bar-btn[aria-current="page"] {
    font-weight: 550;
    color: var(--bar-fg);
    background: rgb(var(--bar-ink) / 0.05);
  }

  .bar-strong {
    font-weight: 550;
  }

  .bar-icon {
    padding-inline: 0.625rem;
  }

  .bar-primary,
  .bar-primary:hover {
    font-weight: 550;
    color: var(--bar-bg);
  }

  .bar-primary {
    background: var(--bar-fg);
    box-shadow:
      0 0 0 1px rgb(var(--bar-ink) / 0.6) inset,
      0 10px 30px -10px rgb(0 212 255 / 0.55);
  }

  .bar-primary:hover {
    background: color-mix(in srgb, var(--bar-fg) 86%, #00d4ff);
    box-shadow:
      0 0 0 1px rgb(var(--bar-ink) / 0.8) inset,
      0 14px 36px -10px rgb(0 212 255 / 0.75);
  }

  .site-bar-github {
    display: none;
  }

  :global(html[data-theme="dark"]) .icon-moon,
  :global(html:not([data-theme="dark"])) .icon-sun {
    display: none;
  }

  @media (min-width: 40rem) {
    .site-bar-github {
      display: inline-flex;
    }
  }

  @media (min-width: 48rem) {
    .site-bar-nav {
      display: flex;
    }
  }
</style>

<script>
  // Light ⇄ dark. Stored under Starlight's key so the site and the docs follow the same choice.
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const label = () => {
    const dark = document.documentElement.dataset.theme === "dark";
    toggle?.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
  };
  label();
  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("starlight-theme", next);
    } catch {
      /* storage blocked: the switch still applies to this page */
    }
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", next === "dark" ? "#07080c" : "#f7f8fa");
    // The docs' phone menu keeps Starlight's own theme picker, so it has to hear about this
    (window as unknown as { StarlightThemeProvider?: { updatePickers(t: string): void } }).StarlightThemeProvider?.updatePickers(next);
    label();
  });
</script>
